# ==========================================
# Rust / Cargo (后端相关)
# ==========================================
# 忽略 Rust 编译生成的 target 目录（体积非常大）
/src-tauri/target/

# ==========================================
# Node.js / 前端生态 (前端相关)
# ==========================================
# 忽略依赖包目录
node_modules/
/src-tauri/node_modules/

# 忽略前端打包输出目录（根据你的前端框架调整，如 dist, build, .next 等）
dist/
build/
.next/
out/

# 忽略日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 操作系统与 IDE (本地开发环境)
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# IDE / 编辑器
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# 密钥与环境变量 (绝对不要提交到 Git)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

# 如果你使用了 Tauri 的应用签名（Updater），忽略私钥文件
/src-tauri/tauri.key
